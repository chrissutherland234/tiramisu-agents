TIRAMISU_ENVIRONMENT=development
TIRAMISU_LOG_LEVEL=INFO
# Point these at a dedicated Tiramisu database; it may be an existing local PostgreSQL server.
TIRAMISU_DATABASE_URL=postgresql+asyncpg://tiramisu_app:tiramisu_app@localhost:5432/tiramisu
TIRAMISU_MIGRATION_DATABASE_URL=postgresql+asyncpg://tiramisu:tiramisu@localhost:5432/tiramisu
TIRAMISU_TEMPORAL_TARGET=localhost:7233
TIRAMISU_TEMPORAL_NAMESPACE=default
TIRAMISU_TEMPORAL_TASK_QUEUE=tiramisu-agent
# JSON array of deployment-authorized tenant UUIDs. CLI --tenant-id values replace this list.
TIRAMISU_WORKER_TENANT_IDS=[]
TIRAMISU_API_HOST=127.0.0.1
TIRAMISU_API_PORT=8000
TIRAMISU_OPENAI_MODEL=
# Local fictional-process ingress and operator testing only.
TIRAMISU_ALLOW_UNSAFE_DEVELOPMENT_TENANT_HEADER=false
TIRAMISU_LOAD_FICTIONAL_EXAMPLE_PROCESSES=false
# Explicit zero-argument factory in an installed/editable package (module:attribute).
TIRAMISU_CLIENT_PACK_FACTORY=
OPENAI_API_KEY=

# Read by Vite from the repository-level .env file.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# If these database values change, update both TIRAMISU database URLs above too.
POSTGRES_DB=tiramisu
POSTGRES_USER=tiramisu
POSTGRES_PASSWORD=tiramisu
